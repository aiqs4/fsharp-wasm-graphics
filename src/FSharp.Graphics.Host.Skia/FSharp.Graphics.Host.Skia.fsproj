<Project Sdk="Microsoft.NET.Sdk">
  <!-- OPTIONAL accelerated backend. Nothing in src/ depends on this project; it can be deleted the
       day a native FSharp.Graphics GPU backend replaces it. Native Skia binaries are referenced by
       the app that hosts it (see demo/FSharp.Graphics.DesktopRunner). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FSharp.Graphics.Host.Skia</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SkiaSink.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Graphics.Host/FSharp.Graphics.Host.fsproj" />
  </ItemGroup>
</Project>
