<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop/.NET-only host services: protocol decoder, software backend, fonts, PNG.
       NEVER referenced by the WASM build. Backends (Skia, ...) live in their own projects. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FSharp.Graphics.Host</RootNamespace>
    <AssemblyName>FSharp.Graphics.Host</AssemblyName>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);FS3370;FS3391</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Raster.fs" />
    <Compile Include="Reader.fs" />
    <Compile Include="Fonts.fs" />
    <Compile Include="GlyphAuraText.fs" />
    <Compile Include="Raster.fs" />
    <Compile Include="Png.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Math/FSharp.Math.fsproj" />
    <ProjectReference Include="../FSharp.Graphics.Core/FSharp.Graphics.Core.fsproj" />
    <ProjectReference Include="../FSharp.Graphics.Primitives/FSharp.Graphics.Primitives.fsproj" />
    <ProjectReference Include="../FSharp.Graphics.Scene/FSharp.Graphics.Scene.fsproj" />
    <ProjectReference Include="../FSharp.Graphics.Render/FSharp.Graphics.Render.fsproj" />
    <ProjectReference Include="../../lib/GlyphAura/src/GlyphAura/GlyphAura.fsproj" />
  </ItemGroup>
</Project>
