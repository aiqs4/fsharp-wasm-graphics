<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless driver: renders the DSL / widget gallery / CSG showcase and replays a scripted
       pointer + keyboard session against the GUI builder, writing PNGs through the real pipeline. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Showcase.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Graphics.GuiBuilder/FSharp.Graphics.GuiBuilder.fsproj" />
    <ProjectReference Include="../../src/FSharp.Graphics.Host/FSharp.Graphics.Host.fsproj" />
  </ItemGroup>
</Project>
