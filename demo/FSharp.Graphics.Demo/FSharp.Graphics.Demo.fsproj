<Project Sdk="Microsoft.NET.Sdk">
  <!-- PNG exporter: every scene goes through the REAL pipeline
       Stage (resolve/diff/cache/encode) -> command stream -> decoder -> software backend. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>FSharp.Graphics.Demo</AssemblyName>
    <RootNamespace>FSharp.Graphics.Demo</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Graphics.Scenes/FSharp.Graphics.Scenes.fsproj" />
    <ProjectReference Include="../../src/FSharp.Graphics.Host/FSharp.Graphics.Host.fsproj" />
  </ItemGroup>
</Project>
