<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FSharp.Graphics.DesktopRunner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="OpcodeDecoder.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
  </ItemGroup>

  <!-- Replace these paths with the actual relative paths to your core F# graphics projects -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FSharp.Graphics\FSharp.Graphics.fsproj" />
    <ProjectReference Include="..\..\src\FSharp.Math\FSharp.Math.fsproj" />
  </ItemGroup>

</Project>