<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency-free regression tests (no test framework, no Skia): `dotnet run` exits 1 on failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>FSharp.Graphics.HostTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../demo/FSharp.Graphics.Scenes/FSharp.Graphics.Scenes.fsproj" />
    <ProjectReference Include="../../src/FSharp.Graphics.Host/FSharp.Graphics.Host.fsproj" />
  </ItemGroup>
</Project>
