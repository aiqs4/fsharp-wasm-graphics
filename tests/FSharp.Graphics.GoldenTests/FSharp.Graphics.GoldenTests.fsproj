<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>FSharp.Graphics.GoldenTests</AssemblyName>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Png.fs" />
    <Compile Include="Rasterizer.fs" />
    <Compile Include="GoldenFramework.fs" />
    <Compile Include="GoldenScenes.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FSharp.Math/FSharp.Math.fsproj" />
    <ProjectReference Include="../../src/FSharp.Graphics.Core/FSharp.Graphics.Core.fsproj" />
    <ProjectReference Include="../../src/FSharp.Graphics.Primitives/FSharp.Graphics.Primitives.fsproj" />
    <ProjectReference Include="../../src/FSharp.Graphics.Scene/FSharp.Graphics.Scene.fsproj" />
    <ProjectReference Include="../../lib/GlyphAura/src/GlyphAura/GlyphAura.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copy the bundled DejaVuSans font from GlyphAura's test data -->
    <None Include="../../lib/GlyphAura/tests/GlyphAura.Tests/TestData/DejaVuSans.ttf"
          CopyToOutputDirectory="PreserveNewest" Link="TestData/DejaVuSans.ttf" />
  </ItemGroup>
</Project>
